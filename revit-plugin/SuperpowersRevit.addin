    <FullClassName>SuperpowersRevit.App</FullClassName>
    <VendorId>SPWR</VendorId>
    <VendorDescription>Superpowers Revit Plugin — Plan Views, Elevations, 3D Views, Drofus</VendorDescription>
  </AddIn>
</RevitAddIns>
