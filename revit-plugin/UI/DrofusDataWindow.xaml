<Window x:Class="SuperpowersRevit.UI.DrofusDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drofus Data"
        Width="940" Height="660"
        MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="14,5"/>
            <Setter Property="Margin"   Value="4,0,0,0"/>
            <Setter Property="Height"   Value="28"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding"  Value="5,3"/>
            <Setter Property="Height"   Value="26"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#EFF4FF"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="RowHeight"                Value="24"/>
        </Style>

        <!--
            WPF .NET 8 TextBox has no PlaceholderText property (added in .NET 9).
            This style hides the watermark TextBlock when the TextBox has content.
        -->
        <Style x:Key="WatermarkTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Visibility"        Value="Collapsed"/>
            <Setter Property="IsHitTestVisible"  Value="False"/>
            <Setter Property="Foreground"        Value="#AAAAAA"/>
            <Setter Property="FontStyle"         Value="Italic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="7,0,0,0"/>
        </Style>

    </Window.Resources>

    <DockPanel Margin="10">

        <!-- ── Top toolbar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#E8EDF3"
                CornerRadius="4"
                Padding="8,6"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Label Content="Project:"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Padding="0"
                       FontSize="12"/>

                <ComboBox x:Name="ProjectCombo"
                          Width="280"
                          Height="26"
                          DisplayMemberPath="Name"
                          SelectionChanged="ProjectCombo_SelectionChanged"/>

                <Button Content="↻ Refresh"
                        ToolTip="Reload project list from Drofus"
                        Click="RefreshProjects_Click"/>

                <Separator Width="1" Background="#BBBBBB" Margin="8,0"/>

                <Button Content="Write to Revit"
                        ToolTip="Match Drofus rooms to Revit rooms by number and write data to parameters"
                        Background="#0063B1"
                        Foreground="White"
                        Click="WriteToRevit_Click"/>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="#555555"
                           FontSize="11"
                           Text="Ready."/>

            </StackPanel>
        </Border>

        <!-- ── Tab control ─────────────────────────────────────────────────── -->
        <!-- Last child of DockPanel — fills remaining space via LastChildFill -->
        <TabControl>

            <!-- Rooms tab -->
            <TabItem Header="Rooms">
                <DockPanel Margin="4">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,4,0,6">

                        <!--
                            PlaceholderText is NOT available in WPF .NET 8.
                            Implemented here via a transparent TextBlock overlay inside a Grid.
                            The watermark TextBlock is visible only when the TextBox is empty.
                        -->
                        <Grid Width="240">
                            <TextBox x:Name="RoomSearchBox"
                                     TextChanged="RoomSearch_TextChanged"/>
                            <TextBlock Text="Filter by number, name or function…"
                                       Style="{StaticResource WatermarkTextBlockStyle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource WatermarkTextBlockStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RoomSearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock x:Name="RoomCountText"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="#666666"
                                   FontSize="11"/>

                    </StackPanel>

                    <DataGrid x:Name="RoomsGrid" ItemsSource="{Binding Rooms}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number"
                                                Binding="{Binding Number}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="220"/>
                            <DataGridTextColumn Header="Function"
                                                Binding="{Binding Function}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Level"
                                                Binding="{Binding Level}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Area (m²)"
                                                Binding="{Binding Area, StringFormat=N2}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

            <!-- Items tab -->
            <TabItem Header="Items">
                <DockPanel Margin="4">

                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="0,4,0,6">

                        <Grid Width="240">
                            <TextBox x:Name="ItemSearchBox"
                                     TextChanged="ItemSearch_TextChanged"/>
                            <TextBlock Text="Filter by number, name or category…"
                                       Style="{StaticResource WatermarkTextBlockStyle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource WatermarkTextBlockStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ItemSearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock x:Name="ItemCountText"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Foreground="#666666"
                                   FontSize="11"/>

                    </StackPanel>

                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number"
                                                Binding="{Binding Number}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="200"/>
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                Width="140"/>
                            <DataGridTextColumn Header="Qty"
                                                Binding="{Binding Quantity}"
                                                Width="50"/>
                            <DataGridTextColumn Header="Room ID"
                                                Binding="{Binding RoomId}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
