<Window x:Class="SuperpowersRevit.UI.DrofusDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drofus Data"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F4FF"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Top: project selector + load -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Project:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="ProjectCombo" Width="280" DisplayMemberPath="Name"
                      SelectionChanged="ProjectCombo_SelectionChanged"/>
            <Button Content="Refresh Projects" Click="RefreshProjects_Click" Margin="10,4,4,4"/>
            <Button Content="Write to Revit" Click="WriteToRevit_Click"
                    Background="#0063B1" Foreground="White"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Margin="12,0,0,0" Foreground="#555" FontSize="11"/>
        </StackPanel>

        <!-- Main content: tabs for Rooms / Items -->
        <TabControl DockPanel.Dock="Bottom">

            <TabItem Header="Rooms">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <TextBox x:Name="RoomSearchBox" Width="220" Margin="0,0,6,0"
                                 PlaceholderText="Search rooms…"
                                 TextChanged="RoomSearch_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="RoomsGrid" ItemsSource="{Binding Rooms}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="80"/>
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"   Width="200"/>
                            <DataGridTextColumn Header="Function" Binding="{Binding Function}" Width="160"/>
                            <DataGridTextColumn Header="Level"  Binding="{Binding Level}"  Width="120"/>
                            <DataGridTextColumn Header="Area (m²)" Binding="{Binding Area, StringFormat=F2}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Items">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                        <TextBox x:Name="ItemSearchBox" Width="220" Margin="0,0,6,0"
                                 PlaceholderText="Search items…"
                                 TextChanged="ItemSearch_TextChanged"/>
                    </StackPanel>

                    <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Number"   Binding="{Binding Number}"      Width="80"/>
                            <DataGridTextColumn Header="Name"     Binding="{Binding Name}"        Width="200"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}"    Width="140"/>
                            <DataGridTextColumn Header="Qty"      Binding="{Binding Quantity}"    Width="50"/>
                            <DataGridTextColumn Header="Room ID"  Binding="{Binding RoomId}"      Width="100"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
