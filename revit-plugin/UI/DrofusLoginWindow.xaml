<Window x:Class="SuperpowersRevit.UI.DrofusLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Drofus"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Drofus Connection" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Host URL:"/>
            <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1"
                     PlaceholderText="https://yourcompany.drofus.com"/>

            <Label Grid.Row="1" Grid.Column="0" Content="Username:"/>
            <TextBox x:Name="UsernameBox" Grid.Row="1" Grid.Column="1"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Password:"/>
            <PasswordBox x:Name="PasswordBox" Grid.Row="2" Grid.Column="1"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="11"
                   Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            <Button Content="Connect" Click="Connect_Click" IsDefault="True"
                    Background="#0063B1" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
